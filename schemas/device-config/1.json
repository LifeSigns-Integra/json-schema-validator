{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Device config",
  "type": "object",
  "required": ["deviceId", "protocol", "host", "port"],
  "properties": {
    "deviceId": { "type": "string", "minLength": 1 },
    "protocol": { "enum": ["HL7", "SERIAL", "TCP"] },
    "host": { "type": "string", "anyOf": [{ "format": "ipv4" }, { "format": "hostname" }] },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "pollIntervalMs": { "type": "integer", "minimum": 100, "default": 1000 },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  },
  "additionalProperties": false
}
